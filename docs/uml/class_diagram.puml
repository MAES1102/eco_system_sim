@startuml class_diagram
title Ecosystem Simulation — Class Diagram (post rule-DSL / DES refactor)

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #E8F4FD
skinparam abstractClassHeaderBackgroundColor #FFF3E0
skinparam interfaceBackgroundColor #E8F5E9
skinparam ArrowColor #2C3E50
skinparam classBorderColor #2C3E50
skinparam packageBorderColor #7F8C8D
skinparam packageBackgroundColor #FAFAFA
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

' ─────────────────────────────────────────────────────────────────
'  ENTITIES PACKAGE
' ─────────────────────────────────────────────────────────────────
package "com.ecosystem.simulation.entities" {

    abstract class Entity {
        # id : int
        # x : int
        # y : int
        # alive : boolean
        # world : World
        # statistics : Statistics
        # schedulingContext : SchedulingContext
        - pendingRemoval : boolean
        - {static} nextId : int
        ..
        + Entity(x : int, y : int)
        + {abstract} update() : void
        + isAlive() : boolean
        + die() : void
        + isPendingRemoval() : boolean
        + scheduleRemoval(cause : String) : void
        + moveTo(newX : int, newY : int) : void
        + getWorld/getStatistics/getSchedulingContext() : ...
    }

    abstract class Organism {
        # energy : int
        # age : int
        # maxEnergy : int
        ..
        + gainEnergy(amount : int) : void
        + consumeEnergy(amount : int) : void
        # increaseAge() : void
    }

    abstract class Animal {
        # speed : double
        # visionRange : int
        ..
        + move() : void
    }

    interface Movable {
        + move() : void
        + getSpeed() : double
    }

    interface Reproducible {
        + reproduce() : void
    }

    class Plant {
        - growthRate : double
        - maxAge, reproductionCooldownPeriod, populationCap : int
        ..
        + update() : void
        + grow() : void
        + reproduce() : void
    }

    class Herbivore {
        # defensePower : int
        - maxAge, reproductionCooldownPeriod, populationCap : int
        ..
        + graze() : boolean
        + defend(attacker : Predator) : boolean
        + flee(predator : Predator) : void
        + reproduce() : void
    }

    class Predator {
        # attackPower : int
        - fedCooldown, maxAge, reproductionCooldownPeriod, populationCap : int
        ..
        + hunt() : boolean
        + attack(target : Entity) : boolean
        + chase(target : Entity) : void
        + reproduce() : void
    }

    class EntityFactory {
        - config : SimulationConfig
        - world : World
        - statistics : Statistics
        - schedulingContext : SchedulingContext
        ..
        + createPredator/createHerbivore/createPlant(x,y) : ...
        + createOffspringNear(parent : Entity) : Entity
    }

    Entity       <|-- Organism
    Organism     <|-- Animal
    Organism     <|-- Plant
    Animal       <|-- Herbivore
    Animal       <|-- Predator
    Animal       ..|> Movable
    Predator     ..|> Reproducible
    Herbivore    ..|> Reproducible
    Plant        ..|> Reproducible

    EntityFactory ..> Predator : creates
    EntityFactory ..> Herbivore : creates
    EntityFactory ..> Plant : creates
}

' ─────────────────────────────────────────────────────────────────
'  EVENTS PACKAGE — the discrete-event (FEL) layer
' ─────────────────────────────────────────────────────────────────
package "com.ecosystem.simulation.events" {

    interface SchedulingContext {
        + schedule(event : SimulationEvent) : void
        + getClock() : int
        + getWorld/getStatistics/getRuleEngine/getVocabulary/getEntityFactory() : ...
    }

    abstract class SimulationEvent {
        - scheduledTime : int
        - source : Entity
        - sequenceNumber : long
        ..
        + {abstract} execute(ctx : SchedulingContext) : void
        + {abstract} getDescription() : String
        + compareTo(other : SimulationEvent) : int
    }

    class EntityActivityEvent {
        - entity : Entity
        ..
        + execute(ctx) : void
        note : owns aging, energy, movement,\nrule evaluation, self-reschedules
    }

    class EnvironmentRegenerationEvent {
        + execute(ctx) : void
        note : recurring, self-reschedules
    }

    class DeathEvent {
        - cause : String
        ..
        + execute(ctx) : void
        note : sole owner of Entity.die(),\nStatistics.recordDeath, World.removeEntity
    }

    class PredationEvent {
        - prey : Entity
        - energyGained : int
        ..
        + execute(ctx) : void
        note : owns predator-side kill effects;\nschedules prey's DeathEvent
    }

    class ReproductionEvent {
        + execute(ctx) : void
        note : owns offspring creation via\nEntityFactory, birth stat, first activity event
    }

    class MovementEvent {
        - fromX, fromY, toX, toY : int
        ..
        + execute(ctx) : void
        note : OBSERVATIONAL ONLY — no-op body,\ndocumented as non-causal
    }

    class EventQueue<T extends SimulationEvent> {
        - heap : PriorityQueue<T>
        ..
        + enqueue(event : T) : void
        + dequeue() : T
        + peek() : T
    }

    SimulationEvent <|-- EntityActivityEvent
    SimulationEvent <|-- EnvironmentRegenerationEvent
    SimulationEvent <|-- DeathEvent
    SimulationEvent <|-- PredationEvent
    SimulationEvent <|-- ReproductionEvent
    SimulationEvent <|-- MovementEvent
    EventQueue o-- SimulationEvent : orders by scheduledTime,\nties by sequenceNumber
}

' ─────────────────────────────────────────────────────────────────
'  RULES PACKAGE — the DSL: lexer/parser/AST/vocabulary/evaluator
' ─────────────────────────────────────────────────────────────────
package "com.ecosystem.simulation.rules" {

    package "lang" {
        class Lexer
        class Parser
        class Token
        enum TokenType
    }

    package "ast" {
        interface ConditionNode <<sealed>> {
            And, Or, Not, Compare (records)
        }
        interface NumericNode <<sealed>> {
            Literal, Reference, BinaryOp (records)
        }
        interface RuleAction <<sealed>> {
            Mutation, Command (records)
        }
    }

    class RuleVocabulary {
        - readables, writables, commands : Map
        ..
        + registerReadable/registerWritable/registerCommand(...) : void
        + requireReadable/requireWritable/requireCommand(...) : void
        note : the single Open/Closed extension\npoint — no hardcoded switch in Rule
    }

    class Evaluator {
        + {static} evaluateCondition(node, ctx, vocab) : boolean
        + {static} evaluateNumeric(node, ctx, vocab) : double
        + {static} executeActions(actions, ctx, vocab) : void
    }

    class EvaluationContext {
        + entity : Entity
        + world : World
        + statistics : Statistics
        + scheduling : SchedulingContext
    }

    class Rule {
        - condition : ConditionNode
        - actions : List<RuleAction>
        ..
        + matches(entity) : boolean
        + evaluateCondition(ctx) : boolean
        + executeActions(ctx) : void
    }

    class RuleEngine {
        - rules : List<Rule>
        - vocabulary : RuleVocabulary
        ..
        + loadRules(filename) : void
        + parseText(text) : List<Rule>
        + evaluate(entity, world, statistics, scheduling) : void
    }

    class RuleRepository {
        - activeFile : Path
        ..
        + loadActive() : void
        + validateCandidate(text) : List<Rule>
        + replaceActive(rules) : void
        + save(rules) : void
        note : bootstrap-from-classpath-seed,\nwhole-file validate-before-swap,\ntemp-file + atomic-move-with-fallback save
    }

    Rule ..> ConditionNode : composes
    Rule ..> RuleAction : composes
    Rule ..> RuleVocabulary : validates against
    Rule ..> Parser : built by
    Parser ..> Lexer : uses
    Evaluator ..> RuleVocabulary : resolves references via
    RuleEngine o-- Rule : manages
    RuleRepository o-- RuleEngine : wraps
}

' ─────────────────────────────────────────────────────────────────
'  SIMULATION PACKAGE
' ─────────────────────────────────────────────────────────────────
package "com.ecosystem.simulation.simulation" {

    class World {
        - entities : List<Entity>
        - environment : Environment
        ..
        + getNeighbors(entity, radius) : List<Entity>
        + countAliveByType(typeName) : int
    }

    class SimulationConfig {
        - props : Properties
        ..
        + {static} loadOrDefault(path, seedResource) : SimulationConfig
        + worldWidth/predatorEnergy/environmentTemperature/... () : ...
    }

    class SimulationEngine {
        - clock : int
        - eventQueue : EventQueue<SimulationEvent>
        ..
        + initialize() : void
        + step() : void
        + advanceTo(targetTime : int) : void
    }

    SimulationEngine ..|> SchedulingContext
    SimulationEngine *-- World : owns
    SimulationEngine *-- RuleEngine : owns
    SimulationEngine *-- Statistics : owns
    SimulationEngine *-- EntityFactory : owns
    SimulationEngine *-- "EventQueue<SimulationEvent>" : owns (the FEL)
    World *-- Environment : owns
}

' ─────────────────────────────────────────────────────────────────
'  ENVIRONMENT / STATISTICS
' ─────────────────────────────────────────────────────────────────
package "com.ecosystem.simulation.environment" {
    class Environment {
        - foodLevel, maxFoodLevel, foodRegenRate : int
        - temperature : double
        ..
        + regenerateFood() : void
    }
}

package "com.ecosystem.simulation.statistics" {
    class Statistics {
        + recordBirth/recordDeath/recordSuccessfulHunt/recordPlantConsumed(...) : void
    }
}

note bottom of MovementEvent
  <b>Honest event-ownership design (see events package)</b>
  Every mutation has exactly one owner. EntityActivityEvent
  owns routine per-entity behavior (it IS the causal event).
  Predation/reproduction/death each have a dedicated owner.
  MovementEvent never mutates state — it only records that a
  move already happened inside EntityActivityEvent.execute().
end note

note bottom of RuleVocabulary
  <b>Runtime vs. compile-time customization boundary</b>
  Composing NEW rule logic from existing readable/writable
  attributes and commands needs zero Java changes/recompilation.
  Exposing a brand-new attribute or command needs one
  registerX(...) call here and a recompile — stated honestly,
  not hidden.
end note

@enduml
