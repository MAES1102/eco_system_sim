@startuml sequence_simulation_step
title Ecosystem Simulation — Sequence Diagram: One Discrete-Event step()

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceArrowThickness 1.5
skinparam sequenceBoxBackgroundColor #F0F4F8
skinparam participantBackgroundColor #E8F4FD
skinparam participantBorderColor #2C3E50
skinparam actorBackgroundColor #FFF3E0
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam sequenceLifeLineBorderColor #2C3E50
skinparam sequenceDividerBackgroundColor #D5E8D4

actor "Swing Timer /\nHeadlessRunner loop" as Driver

participant "SimulationEngine\n(implements SchedulingContext)" as SE
participant "EventQueue<SimulationEvent>\n(the future-event list)" as FEL
participant "EntityActivityEvent\n:predatorActivity" as EAE
participant "Predator\n:predator" as P
participant "RuleEngine" as RE
participant "PredationEvent" as PE
participant "DeathEvent" as DE
participant "Herbivore\n:prey" as H
participant "Statistics" as ST

== Driver requests one external tick ==

Driver -> SE : step()
activate SE
SE -> SE : advanceTo(clock + 1)

== FEL loop: pop earliest event, adopt its time, execute ==

loop while FEL.peek().scheduledTime <= targetTime
    SE -> FEL : dequeue()
    FEL --> SE : event (earliest scheduledTime;\nties broken by sequenceNumber)
    SE -> SE : clock = event.getScheduledTime()
    note right of SE
      The clock is NEVER incremented independently —
      it only ever adopts a popped event's own time.
      This is the core discrete-event property.
    end note
    SE -> EAE : execute(this)
    activate EAE

    EAE -> P : isAlive() / isPendingRemoval()?
    P --> EAE : alive, not pending

    EAE -> P : update()
    activate P
    P -> P : hunt() -- decides success only
    P -> P : consumeEnergy(cost)
    note right of P : if energy hits 0, schedules\na DeathEvent (cause "starvation")\ninstead of dying directly
    alt hunt succeeded
        P -> SE : schedule(new PredationEvent(clock, this, prey, 45))
        SE -> FEL : enqueue(PredationEvent)
    end
    deactivate P

    EAE -> RE : evaluate(predator, world, statistics, this)
    activate RE
    RE -> RE : for each rule in file order:\nmatches? evaluateCondition? executeActions?
    deactivate RE

    EAE -> SE : schedule(new EntityActivityEvent(clock+1, predator))
    SE -> FEL : enqueue(next activity event)
    note right of FEL : the activity chain\nself-reschedules while alive
    deactivate EAE
end

== Later in the same wave: the scheduled PredationEvent is popped ==

SE -> FEL : dequeue()
FEL --> SE : PredationEvent
SE -> PE : execute(this)
activate PE
PE -> P : gainEnergy(45), setFedCooldown(10)
PE -> ST : recordSuccessfulHunt()
PE -> H : scheduleRemoval("predation")
activate H
H -> H : pendingRemoval = true
H -> SE : schedule(new DeathEvent(clock, this, "predation"))
SE -> FEL : enqueue(DeathEvent)
deactivate H
deactivate PE

== The scheduled DeathEvent is popped -- sole owner of the death mutation ==

SE -> FEL : dequeue()
FEL --> SE : DeathEvent
SE -> DE : execute(this)
activate DE
DE -> H : die()
note right of DE
  DeathEvent.execute() is the ONLY call
  site of Entity.die() in the running
  simulation, regardless of cause.
end note
DE -> ST : recordDeath("Herbivore")
DE -> SE : getWorld().removeEntity(prey)
deactivate DE

deactivate SE

@enduml
